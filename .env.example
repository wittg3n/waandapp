NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/waandapp
REDIS_URL=redis://localhost:6380
MONGODB_PORT=27017
REDIS_PORT=6380
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Only the dashboard may originate credential/session mutations.
AUTH_MUTATION_ORIGINS=http://localhost:3001
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY_HOPS=0

# Development-only credentials. Production rejects these placeholders.
SESSION_SECRET=development-only-session-secret-change-before-production-2026
SESSION_COOKIE_NAME=waand.sid
SESSION_IDLE_TTL_MS=3600000
SESSION_ABSOLUTE_TTL_MS=86400000
AUTH_CODE_PEPPER=development-only-auth-code-pepper-change-before-production-2026
AUTH_CODE_TTL_MS=300000
AUTH_TRANSACTION_TTL_MS=1200000
AUTH_STEP_UP_TTL_MS=600000
AUTH_TERMS_VERSION=v1
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1
AUTH_MAX_VERIFY_ATTEMPTS=5
AUTH_MAX_SENDS_PER_TRANSACTION=5
AUTH_RESEND_COOLDOWN_MS=60000

AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTIFIER_WINDOW_MS=900000
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_REQUEST_IP_WINDOW_MS=900000
AUTH_REQUEST_IP_LIMIT=30
AUTH_REQUEST_DESTINATION_WINDOW_MS=3600000
AUTH_REQUEST_DESTINATION_LIMIT=5
AUTH_VERIFY_IP_WINDOW_MS=900000
AUTH_VERIFY_IP_LIMIT=60
AUTH_VERIFY_DESTINATION_WINDOW_MS=900000
AUTH_VERIFY_DESTINATION_LIMIT=10

# Development prints the fixed code 000000 to the API terminal.
# For the local email webhook, switch to webhook and use http://127.0.0.1:4100/email
# with a generated token of at least 32 characters.
AUTH_DELIVERY_MODE=development
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=
# A missing development channel fails closed. Production requires both HTTPS webhook pairs.
AUTH_SMS_WEBHOOK_URL=
AUTH_SMS_WEBHOOK_TOKEN=

BLOG_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BLOG_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USER_DASHBOARD_URL=http://localhost:3001
VITE_API_URL=http://localhost:4000/api/v1
API_PORT=4000
BLOG_PORT=3002
WEB_PORT=3000
USER_DASHBOARD_PORT=3001
