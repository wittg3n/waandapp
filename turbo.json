{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "MONGODB_URI",
    "REDIS_URL",
    "CORS_ORIGINS",
    "ADMIN_DASHBOARD_ORIGIN",
    "AUTH_MUTATION_ORIGINS",
    "LOG_LEVEL",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX",
    "TRUST_PROXY_HOPS",
    "SESSION_SECRET",
    "SESSION_COOKIE_NAME",
    "SESSION_IDLE_TTL_MS",
    "SESSION_ABSOLUTE_TTL_MS",
    "ADMIN_SESSION_SECRET",
    "ADMIN_SESSION_COOKIE_NAME",
    "ADMIN_SESSION_IDLE_TTL_MS",
    "ADMIN_SESSION_ABSOLUTE_TTL_MS",
    "AUTH_CODE_PEPPER",
    "AUTH_CODE_TTL_MS",
    "AUTH_TRANSACTION_TTL_MS",
    "AUTH_STEP_UP_TTL_MS",
    "AUTH_TERMS_VERSION",
    "AUTH_ARGON2_MEMORY_KIB",
    "AUTH_ARGON2_TIME_COST",
    "AUTH_ARGON2_PARALLELISM",
    "AUTH_MAX_VERIFY_ATTEMPTS",
    "AUTH_MAX_SENDS_PER_TRANSACTION",
    "AUTH_RESEND_COOLDOWN_MS",
    "AUTH_LOGIN_IP_WINDOW_MS",
    "AUTH_LOGIN_IP_LIMIT",
    "AUTH_LOGIN_IDENTIFIER_WINDOW_MS",
    "AUTH_LOGIN_IDENTIFIER_LIMIT",
    "AUTH_REQUEST_IP_WINDOW_MS",
    "AUTH_REQUEST_IP_LIMIT",
    "AUTH_REQUEST_DESTINATION_WINDOW_MS",
    "AUTH_REQUEST_DESTINATION_LIMIT",
    "AUTH_VERIFY_IP_WINDOW_MS",
    "AUTH_VERIFY_IP_LIMIT",
    "AUTH_VERIFY_DESTINATION_WINDOW_MS",
    "AUTH_VERIFY_DESTINATION_LIMIT",
    "AUTH_DELIVERY_MODE",
    "AUTH_EMAIL_WEBHOOK_URL",
    "AUTH_EMAIL_WEBHOOK_TOKEN",
    "AUTH_SMS_WEBHOOK_URL",
    "AUTH_SMS_WEBHOOK_TOKEN",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_USER_DASHBOARD_URL",
    "VITE_API_URL",
    "ADMIN_DASHBOARD_PORT",
    "MONGODB_CORE_DATABASE",
    "MONGODB_CMS_DATABASE",
    "CMS_MEDIA_ROOT",
    "CMS_MEDIA_MAX_BYTES",
    "CMS_SCHEDULER_INTERVAL_MS"
  ],
  "tasks": {
    "@waandapp/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "clean": {
      "cache": false
    }
  }
}
